{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-maker.local/specs/schema.json",
  "title": "VideoSpec",
  "description": "Contrato de roteiro para o grok bot. Cada arquivo em public/specs/*.json vira uma composition no Remotion Studio.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "fps", "width", "height", "palette", "scenes"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$",
      "description": "Deve ser igual ao nome do arquivo (id.json) e vira o ID da composition."
    },
    "title": { "type": "string", "minLength": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0, "default": 30 },
    "width": { "type": "integer", "minimum": 16, "default": 1920 },
    "height": { "type": "integer", "minimum": 16, "default": 1080 },
    "durationInSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Opcional. A duração real do vídeo é a soma das cenas."
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "primary", "secondary", "text"],
      "properties": {
        "background": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "primary": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "secondary": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "text": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "muted": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string",
          "description": "Caminho relativo a public/, ex: audio/narracao.mp3"
        },
        "music": {
          "type": "string",
          "description": "Caminho relativo a public/, ex: audio/musica.mp3"
        },
        "musicVolume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.15 },
        "mixed": {
          "type": "string",
          "description": "Saída do npm run mix. Se o arquivo existir, substitui narration+music."
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "atSeconds"],
            "properties": {
              "file": { "type": "string" },
              "atSeconds": { "type": "number", "minimum": 0 },
              "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.4 }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "durationInSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "durationInSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "narration": { "type": "string" },
          "visual": { "type": "string" },
          "image": {
            "type": "string",
            "description": "Caminho relativo a public/, ex: assets/cena-01.png. Ignorado se a cena tiver video."
          },
          "video": {
            "description": "Clipe gerado fora daqui (HeyGen, Kling, Sora, filmagem). string ou objeto.",
            "oneOf": [
              {
                "type": "string",
                "description": "Caminho relativo a public/, ex: clips/pessoa-falando.mp4"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Caminho relativo a public/, ex: clips/pessoa-falando.mp4"
                  },
                  "startFromSeconds": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Corta o início do clipe de origem."
                  },
                  "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 },
                  "muted": {
                    "type": "boolean",
                    "default": false,
                    "description": "true quando a fala vai na narração do spec, não no áudio do clipe."
                  },
                  "fit": { "enum": ["cover", "contain"], "default": "cover" }
                }
              }
            ]
          },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "background": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enter": { "enum": ["fade", "slide-up", "scale", "none"] },
              "exit": { "enum": ["fade", "slide-up", "scale", "none"] },
              "kenBurns": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
